PORT=8080
LOG_LEVEL=info
# HS256 secret for the simulated login (Secret Manager in the cloud)
AUTH_SECRET=change-me
AUTH_ISSUER=https://gateway.aforo.dev
TOKEN_TTL_HOURS=8
FRONTEND_ORIGIN=http://localhost:4200
CATALOG_URL=https://aforo-catalog-xxxx.a.run.app
QUEUE_URL=https://aforo-queue-xxxx.a.run.app
ORDERS_URL=https://aforo-orders-xxxx.a.run.app
INVENTORY_URL=https://aforo-inventory-xxxx.a.run.app
MOCK_PAYMENT_GATEWAY_URL=https://aforo-mock-payment-gateway-xxxx.a.run.app
RATE_LIMIT_QUEUE_PER_MIN=60
RATE_LIMIT_DEFAULT_PER_MIN=600
# dev: skip real Google ID tokens when calling backends
AUTH_MODE=cloud
