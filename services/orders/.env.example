PORT=8080
LOG_LEVEL=info
DATABASE_URL=postgres://orders:change-me@127.0.0.1:5432/orders
GCP_PROJECT_ID=aforo-dev
# In the cloud both URLs are set by Terraform from the target resources (ADR-0004)
INVENTORY_URL=https://aforo-inventory-xxxx.a.run.app
PAYMENT_GATEWAY_URL=https://aforo-mock-payment-gateway-xxxx.a.run.app
TOPIC_ORDER_PAID=aforo.orders.order-paid
# ADR-0005: 3 in the cloud (one instance), 1 when running locally against dev
DB_POOL_MAX=3
FRONTEND_ORIGIN=http://localhost:4200
# HMAC secret shared with the mock payment gateway (Secret Manager in the cloud)
WEBHOOK_SECRET=change-me
# Payment adapter resilience policy (D-18)
HTTP_CONNECT_TIMEOUT_MS=500
HTTP_RESPONSE_TIMEOUT_MS=2000
CB_FAILURE_THRESHOLD=5
CB_RESET_TIMEOUT_MS=30000
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=200
RETRY_MAX_DELAY_MS=5000
AUTH_MODE=cloud
