{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Quality P1, component C4. Run with `npm run test:p1:mutation --workspace=@aforo/orders` (sets P1_COMPONENT=c4 for jest.p1.config.js).",
  "packageManager": "npm",
  "testRunner": "jest",
  "jest": { "projectType": "custom", "configFile": "jest.p1.config.js", "enableFindRelatedTests": false },
  "plugins": ["@stryker-mutator/jest-runner"],
  "mutate": ["src/payments/webhook.service.ts", "src/payments/webhook-signature.ts"],
  "coverageAnalysis": "perTest",
  "reporters": ["clear-text", "progress", "html", "json"],
  "htmlReporter": { "fileName": "../../quality/reports/c4/mutation/index.html" },
  "jsonReporter": { "fileName": "../../quality/reports/c4/mutation/mutation.json" },
  "cleanTempDir": "always",
  "thresholds": { "high": 80, "low": 60, "break": null }
}
