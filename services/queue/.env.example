PORT=8080
LOG_LEVEL=info
# Local: docker run --rm -p 6379:6379 redis:7. In the cloud, Terraform sets it from Memorystore
# and leaves it empty while Memorystore is off (ADR-0001).
REDIS_URL=redis://127.0.0.1:6379
ADMISSION_BATCH_SIZE=500
ADMISSION_INTERVAL_SECONDS=5
PASS_TTL_SECONDS=600
SSE_HEARTBEAT_SECONDS=15
AUTH_MODE=cloud
