{
  "name": "@aforo/queue",
  "version": "0.1.0",
  "private": true,
  "description": "Aforo waiting room: queue order, admission and SSE",
  "scripts": {
    "predev": "npm run build --workspace=@aforo/common && npm run build",
    "dev": "node --env-file=.env dist/main.js",
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build --workspace=@aforo/common && npm run build",
    "test": "node --test --test-concurrency=1 \"test/*.test.cjs\"",
    "start": "node dist/main.js",
    "test:p1": "vitest run -c vitest.p1.config.mts --coverage",
    "test:p1:mutation": "stryker run stryker.p1.config.json"
  },
  "dependencies": {
    "@aforo/common": "^0.1.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "fastify": "^5.0.0",
    "ioredis": "^5.11.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^24.19.1",
    "@vitest/coverage-istanbul": "^5.0.3",
    "typescript": "^5.8.0",
    "vitest": "^5.0.3"
  }
}
