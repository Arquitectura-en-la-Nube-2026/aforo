{
  "name": "@aforo/inventory",
  "version": "0.1.0",
  "private": true,
  "description": "Aforo inventory: availability, reservations and their expiry",
  "scripts": {
    "predev": "npm run build --workspace=@aforo/common && npm run build",
    "dev": "node --env-file=.env dist/main.js",
    "build": "tsc -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "migrate": "node dist/db/migrate.js",
    "pretest": "npm run build --workspace=@aforo/common && npm run build",
    "test": "node --test --test-concurrency=1 \"test/*.test.cjs\" \"test/concurrency/*.test.cjs\"",
    "start": "node dist/main.js",
    "test:p1": "vitest run -c vitest.p1.config.mts --coverage"
  },
  "dependencies": {
    "@aforo/common": "^0.1.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "fastify": "^5.0.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-istanbul": "^5.0.3",
    "typescript": "^5.8.0",
    "vitest": "^5.0.3"
  }
}
