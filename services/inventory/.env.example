PORT=8080
SERVICE_NAME=inventory
LOG_LEVEL=info
# Local Postgres; in the cloud Terraform injects it from Secret Manager.
DATABASE_URL=postgres://inventory:change-me@127.0.0.1:5432/inventory
# ADR-0005: 2 per instance in the cloud, 1 when running locally against dev
DB_POOL_MAX=1
GCP_PROJECT_ID=aforo-dev-teamf
GCP_REGION=southamerica-east1
TOPIC_RESERVATION_EXPIRED=aforo.inventory.reservation-expired
# local: a timer calls /expire (no Cloud Tasks emulator); cloud-tasks in the cloud (Terraform)
EXPIRY_SCHEDULER=local
TASKS_QUEUE=reservation-expiry
# Required with cloud-tasks: the task calls SELF_URL/internal/v1/reservations/{id}/expire
SELF_URL=http://127.0.0.1:8080
TASKS_INVOKER_SERVICE_ACCOUNT=aforo-tasks-invoker@aforo-dev-teamf.iam.gserviceaccount.com
# Point the outbox at the Pub/Sub emulator locally (gcloud beta emulators pubsub start)
# PUBSUB_EMULATOR_HOST=127.0.0.1:8085
AUTH_MODE=dev
