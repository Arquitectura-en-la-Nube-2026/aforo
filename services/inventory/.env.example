PORT=8080
LOG_LEVEL=info
DATABASE_URL=postgres://inventory:change-me@127.0.0.1:5432/inventory
GCP_PROJECT_ID=aforo-dev
GCP_REGION=southamerica-east1
TOPIC_RESERVATION_EXPIRED=aforo.inventory.reservation-expired
# ADR-0005: 2 in the cloud (max 3 instances), 1 when running locally against dev
DB_POOL_MAX=2
# cloud-tasks | local
EXPIRY_SCHEDULER=cloud-tasks
TASKS_QUEUE=reservation-expiry
# Base URL Cloud Tasks calls back (this service's own URL)
SELF_URL=https://aforo-inventory-xxxx.a.run.app
TASKS_INVOKER_SERVICE_ACCOUNT=aforo-tasks-invoker@aforo-dev.iam.gserviceaccount.com
AUTH_MODE=cloud
