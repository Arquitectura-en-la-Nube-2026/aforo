{
  "name": "aforo",
  "private": true,
  "description": "Aforo ticketing platform — two-week purchase happy-path prototype",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "functions/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@aforo/common && npm run build --workspace=@aforo/gateway && npm run build --workspace=@aforo/queue",
    "build:common": "npm run build --workspace=@aforo/common",
    "build:gateway": "npm run build --workspace=@aforo/gateway",
    "build:queue": "npm run build --workspace=@aforo/queue",
    "lint:contracts": "make lint-contracts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.3.0"
  }
}
