LOG_LEVEL=info
GCP_PROJECT_ID=aforo-dev-teamf
GCP_REGION=southamerica-east1
TASKS_QUEUE=prewarm-windows
# Base URL Cloud Tasks calls back (this function's own URL); also the OIDC audience
SELF_URL=https://aforo-prewarmer-68220265740.southamerica-east1.run.app
TASKS_INVOKER_SERVICE_ACCOUNT=aforo-tasks-invoker@aforo-dev-teamf.iam.gserviceaccount.com
# service:warmMinimum, comma-separated
TARGET_SERVICES=aforo-gateway:1,aforo-queue:1
BASELINE_MIN_INSTANCES=0
# Warm this long before salesOpensAt
PREWARM_LEAD_SECONDS=600
# Cool at min(salesClosesAt, salesOpensAt + this)
PREWARM_HOLD_SECONDS=3600
