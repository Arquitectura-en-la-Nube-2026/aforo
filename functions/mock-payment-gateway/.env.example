LOG_LEVEL=info
GCP_PROJECT_ID=aforo-dev-teamf
GCP_REGION=southamerica-east1
# Public base URL the browser uses (the Gateway) to build checkoutUrl
PUBLIC_BASE_URL=http://localhost:8080/mock-gateway
ORDERS_WEBHOOK_URL=http://localhost:8080/api/v1/payments/webhook
# Shared with orders (Secret Manager in the cloud)
WEBHOOK_SECRET=change-me
WEBHOOK_DELAY_SECONDS=2
TASKS_QUEUE=payment-webhooks
SELF_URL=https://aforo-mock-payment-gateway-xxxx.a.run.app
TASKS_INVOKER_SERVICE_ACCOUNT=aforo-tasks-invoker@aforo-dev-teamf.iam.gserviceaccount.com
# none | error | timeout — in the cloud, set only via `make fault MODE=…` (Terraform switch)
FAULT_MODE=none
FAULT_DELAY_MS=5000
# Timeout (ms) of the call to Orders' webhook; must be below the function timeout (30 s)
DISPATCH_TIMEOUT_MS=20000
