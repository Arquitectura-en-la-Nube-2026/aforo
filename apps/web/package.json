{
  "name": "@aforo/web",
  "version": "0.1.0",
  "private": true,
  "description": "Aforo purchase frontend (Next.js, App Router)",
  "scripts": {
    "dev": "next dev -p 4000",
    "build": "next build",
    "start": "next start -p ${PORT:-4000}",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:api": "node scripts/gen-api-types.mjs",
    "mock": "node mock-server/server.mjs",
    "test:p1": "vitest run -c vitest.p1.config.mts --coverage"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-radio-group": "^1.3.0",
    "@radix-ui/react-slot": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-istanbul": "^5.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "^29.1.0",
    "openapi-typescript": "^7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5"
  }
